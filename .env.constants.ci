# CI plumbing profile: same as .env.constants except the supervisor, literature and trials dials, turned down so a cold
# GitHub run finishes quickly. The structural specs and precision gate are expected to fail on it.
# Select with CONSTANTS_FILE=.env.constants.ci (the regression job does).
LLM_MAX_TOKENS=8192
SMALL_LLM_MAX_TOKENS=1024
DEFAULT_TIMEOUT=30.0
DEFAULT_MAX_RETRIES=3
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=30
LITERATURE_TOP_K=15
SEMANTIC_SEARCH_TOP_K=15
PUBMED_MAX_RESULTS=50
PUBMED_SEARCH_DEFAULT_MAX_RESULTS=50
PUBMED_ESUMMARY_BATCH_SIZE=200
PUBMED_EFETCH_BATCH_SIZE=100
RAG_LLM_CONCURRENCY=4
RAG_PUBMED_CONCURRENCY=3
RAG_DISEASE_CONCURRENCY=4
EUROPE_PMC_EXTRACTION_CONCURRENCY=8
CLINICAL_TRIALS_LANDSCAPE_MAX_TRIALS=10
SUPERVISOR_CANDIDATE_CAP=60
SUPERVISOR_INVESTIGATION_CAP=3
SUPERVISOR_INVESTIGATION_CONCURRENCY=3
MECHANISM_SIGNAL_THRESHOLD=0.4
MECHANISM_ASSOCIATIONS_CAP=10
MECHANISM_ASSOCIATIONS_PER_TARGET=30
MECHANISM_TOP_CANDIDATES=10
DISEASE_PUBMED_MIN_RESULTS=3
OPEN_TARGETS_PAGE_SIZE=500
OPEN_TARGETS_COMPETITOR_PREFETCH_MAX=80
OPEN_TARGETS_ASSOCIATION_MIN_SCORE=0.1
SUPERVISOR_FANOUT=true
