# Tunable limits — production defaults.
# Override for tests: CONSTANTS_FILE=.env.constants.test pytest

# LLM token limits
LLM_MAX_TOKENS=8192
SMALL_LLM_MAX_TOKENS=1024

# Base client
DEFAULT_TIMEOUT=30.0
DEFAULT_MAX_RETRIES=3

# Database pool (must exceed 1 + SUPERVISOR_INVESTIGATION_CAP concurrent sessions)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=30

# Literature / RAG
# Despite the name, only used to trim the merged competitor-disease list in get_drug_competitors.
LITERATURE_TOP_K=60
SEMANTIC_SEARCH_TOP_K=5
PUBMED_MAX_RESULTS=200
PUBMED_SEARCH_DEFAULT_MAX_RESULTS=50
PUBMED_ESUMMARY_BATCH_SIZE=200
PUBMED_EFETCH_BATCH_SIZE=100
RAG_LLM_CONCURRENCY=4
RAG_PUBMED_CONCURRENCY=3
RAG_DISEASE_CONCURRENCY=4
EUROPE_PMC_EXTRACTION_CONCURRENCY=8

# Clinical trials
CLINICAL_TRIALS_LANDSCAPE_MAX_TRIALS=50
CLINICAL_TRIALS_CAP=20

# Supervisor
SUPERVISOR_CANDIDATE_CAP=60
SUPERVISOR_INVESTIGATION_CAP=16

# Mechanism
MECHANISM_SIGNAL_THRESHOLD=0.4
MECHANISM_ASSOCIATIONS_CAP=10
MECHANISM_ASSOCIATIONS_PER_TARGET=30
MECHANISM_TOP_CANDIDATES=10

# Disease helper
DISEASE_PUBMED_MIN_RESULTS=3

# Open Targets
OPEN_TARGETS_PAGE_SIZE=500
OPEN_TARGETS_COMPETITOR_PREFETCH_MAX=60
OPEN_TARGETS_ASSOCIATION_MIN_SCORE=0.1

# Supervisor parallel fan-out (smoke testing only)
SUPERVISOR_FANOUT=true
